# =========================================================
# Dependencies
# =========================================================
# Ignores node_modules directories at any depth in the tree.
node_modules/
jspm_packages/

# =========================================================
# Build / Compilation Output
# =========================================================
# TailwindCSS and PostCSS generate processed CSS from src/.
# Adjust if your build output lives elsewhere.
build/
out/
.cache/
.parcel-cache/
.tmp/
.temp/
*.tsbuildinfo

# =========================================================
# Logs
# =========================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================================================
# Environment & Local Secrets
# =========================================================
.env
.env.local
.env.*.local

